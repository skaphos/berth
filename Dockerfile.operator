FROM --platform=$BUILDPLATFORM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Build on the native runner arch and cross-compile to the platform buildx
# requests (TARGETOS/TARGETARCH are injected per target), so the arm64 image
# is produced without QEMU-emulating the entire Go toolchain.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/operator ./cmd/operator

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

COPY --from=build /out/operator /operator

USER 65532:65532
ENTRYPOINT ["/operator"]
