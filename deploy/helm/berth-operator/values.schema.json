{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "berth-operator values",
  "type": "object",
  "required": ["image", "berth", "rbac"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag":        {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride":     {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "replicaCount":     {"type": "integer", "minimum": 1, "maximum": 1},
    "clusterID":        {"type": "string"},

    "berth": {
      "type": "object",
      "required": ["apiServer"],
      "properties": {
        "apiServer": {"type": "string"},
        "apiKey": {
          "type": "object",
          "properties": {
            "secretName": {"type": "string"},
            "secretKey":  {"type": "string"}
          }
        },
        "tokenFile": {
          "type": "object",
          "properties": {
            "path": {"type": "string"}
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "caBundleConfigMap": {"type": "string"},
            "caBundleKey":       {"type": "string"},
            "serverName":        {"type": "string"},
            "insecureSkipVerify":{"type": "boolean"}
          }
        }
      }
    },

    "sidecarBroker": {
      "type": "object",
      "properties": {
        "enabled":     {"type": "boolean"},
        "image":       {"type": "object"},
        "oidc":        {"type": "object"},
        "refreshSkew": {"type": "string"},
        "tokenPath":   {"type": "string"},
        "resources":   {"type": "object"}
      }
    },

    "injection": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "helper": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag":        {"type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
            "apiKeyFile": {"type": "string"},
            "stateDir":   {"type": "string", "minLength": 1, "pattern": "^/"}
          }
        },
        "controlPlaneNamespaces": {"type": "array", "items": {"type": "string"}},
        "defaults": {
          "type": "object",
          "properties": {
            "mode":       {"type": "string", "enum": ["runtime-singleton", "startup-gate"]},
            "enforce":    {"type": "string", "enum": ["probe", "signal"]},
            "ttlSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "webhook": {
          "type": "object",
          "properties": {
            "failurePolicy":  {"type": "string", "enum": ["Ignore", "Fail"]},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "servicePort":    {"type": "integer", "minimum": 1, "maximum": 65535},
            "objectSelector": {"type": "object"},
            "namespaceSelector": {"type": "object"},
            "tls": {
              "type": "object",
              "properties": {
                "certManager": {
                  "type": "object",
                  "properties": {
                    "enabled":     {"type": "boolean"},
                    "issuerRef":   {"type": "object"},
                    "duration":    {"type": "string"},
                    "renewBefore": {"type": "string"},
                    "dnsNames":    {"type": "array", "items": {"type": "string"}}
                  }
                },
                "existingSecret": {"type": "string"},
                "caBundle":       {"type": "string"}
              }
            }
          }
        }
      }
    },

    "installCRDs": {"type": "boolean"},

    "rbac": {
      "type": "object",
      "required": ["create"],
      "properties": {
        "create":           {"type": "boolean"},
        "berthLeaseVerbs":  {"type": "array"},
        "targetVerbs":      {"type": "array"},
        "leaderElection":   {"type": "boolean"}
      }
    },

    "metrics":           {"type": "object"},
    "healthProbe":       {"type": "object"},
    "resources":         {"type": "object"},
    "podSecurityContext":{"type": "object"},
    "securityContext":   {"type": "object"},
    "livenessProbe":     {"type": "object"},
    "readinessProbe":    {"type": "object"},
    "nodeSelector":      {"type": "object"},
    "tolerations":       {"type": "array"},
    "affinity":          {"type": "object"},
    "extraArgs":         {"type": "array", "items": {"type": "string"}},
    "extraEnv":          {"type": "array"},
    "extraVolumes":      {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create":      {"type": "boolean"},
        "name":        {"type": "string"},
        "annotations": {"type": "object"}
      }
    }
  }
}
