{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "berth-apiserver values",
  "type": "object",
  "required": ["image", "store", "coordination", "tls", "auth"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag":        {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride":     {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "replicaCount":     {"type": "integer", "minimum": 1},

    "store": {
      "type": "object",
      "required": ["backend", "sql"],
      "properties": {
        "backend": {"type": "string", "enum": ["", "mem", "k8s", "sql"]},
        "sql": {
          "type": "object",
          "required": ["driver", "dsn", "dsnSecret", "migrate"],
          "properties": {
            "driver":   {"type": "string", "enum": ["", "postgres", "mysql", "sqlite"]},
            "dsn":      {"type": "string"},
            "dsnSecret": {
              "type": "object",
              "required": ["name", "key"],
              "properties": {
                "name": {"type": "string"},
                "key":  {"type": "string"}
              }
            },
            "migrate": {"type": "string", "enum": ["auto", "off"]}
          }
        }
      }
    },

    "coordination": {
      "type": "object",
      "required": ["namespace", "inCluster", "kubeconfig"],
      "properties": {
        "namespace":  {"type": "string"},
        "inCluster":  {"type": "boolean"},
        "kubeconfig": {
          "type": "object",
          "properties": {
            "secretName": {"type": "string"},
            "secretKey":  {"type": "string"}
          }
        }
      }
    },

    "tls": {
      "type": "object",
      "properties": {
        "certManager": {
          "type": "object",
          "properties": {
            "enabled":     {"type": "boolean"},
            "issuerRef":   {"type": "object"},
            "duration":    {"type": "string"},
            "renewBefore": {"type": "string"},
            "dnsNames":    {"type": "array", "items": {"type": "string"}}
          }
        },
        "existingSecret": {"type": "string"}
      }
    },

    "auth": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "static-keys", "oidc"]},
        "staticKeys": {
          "type": "object",
          "properties": {
            "secretName": {"type": "string"},
            "secretKey":  {"type": "string"}
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuerURL":      {"type": "string"},
            "audience":       {"type": "string"},
            "jwksURL":        {"type": "string"},
            "usernameClaim":  {"type": "string"},
            "tenantClaim":    {"type": "string"},
            "requiredClaims": {"type": "array", "items": {"type": "string", "pattern": "^[^=]+=.+$"}}
          }
        }
      }
    },

    "service":       {"type": "object"},
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port":    {"type": "integer", "minimum": 1, "maximum": 65535},
        "service": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"}
          }
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled":           {"type": "boolean"},
            "interval":          {"type": "string"},
            "scrapeTimeout":     {"type": "string"},
            "additionalLabels":  {"type": "object"},
            "relabelings":       {"type": "array"},
            "metricRelabelings": {"type": "array"}
          }
        },
        "podAnnotations": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "ingress":       {"type": "object"},
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled":        {"type": "boolean"},
        "minAvailable":   {"oneOf": [{"type": "integer"}, {"type": "string"}]},
        "maxUnavailable": {"oneOf": [{"type": "integer"}, {"type": "string"}]}
      }
    },
    "resources":         {"type": "object"},
    "podSecurityContext":{"type": "object"},
    "securityContext":   {"type": "object"},
    "livenessProbe":     {"type": "object"},
    "readinessProbe":    {"type": "object"},
    "nodeSelector":      {"type": "object"},
    "tolerations":       {"type": "array"},
    "affinity":          {"type": "object"},
    "extraArgs":         {"type": "array", "items": {"type": "string"}},
    "extraEnv":          {"type": "array"},
    "extraVolumes":      {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create":      {"type": "boolean"},
        "name":        {"type": "string"},
        "annotations": {"type": "object"}
      }
    }
  }
}
