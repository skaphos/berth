FROM --platform=$BUILDPLATFORM golang:1.26.5@sha256:c05f28d5148bc5c4b60ab5c002291e830b7e835922d23875152b3af5951cecea AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Build on the native runner arch and cross-compile to the platform buildx
# requests (TARGETOS/TARGETARCH are injected per target), so the arm64 image
# is produced without QEMU-emulating the entire Go toolchain.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/apiserver ./cmd/apiserver

FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35

COPY --from=build /out/apiserver /apiserver

USER nonroot:nonroot
ENTRYPOINT ["/apiserver"]
