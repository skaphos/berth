FROM --platform=$BUILDPLATFORM golang:1.26.4@sha256:32c0e6e5c4f6707717051091b4d0b077464a679eaab563e11474efc5328e2aa5 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Build on the native runner arch and cross-compile to the platform buildx
# requests (TARGETOS/TARGETARCH are injected per target), so the arm64 image
# is produced without QEMU-emulating the entire Go toolchain.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/apiserver ./cmd/apiserver

FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639

COPY --from=build /out/apiserver /apiserver

USER nonroot:nonroot
ENTRYPOINT ["/apiserver"]
