FROM --platform=$BUILDPLATFORM golang:1.26.5@sha256:079e59808d2d252516e27e3f3a9c003740dee7f75e55aa71528766d52bcfc16a AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Build on the native runner arch and cross-compile to the platform buildx
# requests (TARGETOS/TARGETARCH are injected per target), so the arm64 image
# is produced without QEMU-emulating the entire Go toolchain.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/broker ./cmd/berth-oidc-broker

FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639

COPY --from=build /out/broker /broker

USER nonroot:nonroot
ENTRYPOINT ["/broker"]
