FROM --platform=$BUILDPLATFORM golang:1.27.1@sha256:512690a5660563b57d37ecc31129e7f136e831db2aed24a1dbeb8ad7380dc0fa AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Build on the native runner arch and cross-compile to the platform buildx
# requests (TARGETOS/TARGETARCH are injected per target), so the arm64 image
# is produced without QEMU-emulating the entire Go toolchain.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/berth-acquire ./cmd/berth-acquire

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

COPY --from=build /out/berth-acquire /berth-acquire

USER 65532:65532
ENTRYPOINT ["/berth-acquire"]
